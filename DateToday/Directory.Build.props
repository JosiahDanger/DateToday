<!-- This file, 'Directory.Build.props', is a source of exclusive control over configuration for
	 trimming and NativeAOT compilation. -->

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- Release Publishing -->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<PublishAot>true</PublishAot>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<!-- Trimming Feature Switches -->
	<PropertyGroup Condition="'$(PublishAot)' == 'true'">
		<DebuggerSupport>false</DebuggerSupport>
		<MetricsSupport>false</MetricsSupport>
		<StackTraceSupport>false</StackTraceSupport>
		<UseSizeOptimizedLinq>true</UseSizeOptimizedLinq>
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
	</PropertyGroup>

	<!-- NativeAOT Compiler Options -->
	<PropertyGroup Condition="'$(PublishAot)' == 'true'">
		<OptimizationPreference>Size</OptimizationPreference>
		<IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
	</PropertyGroup>

	<!-- The configuration of Windows x64 Native Libraries and Native Linking has been adapted from
		 an example available in the Avalonia-NativeAOT-SingleFile repository of GitHub user
		 PeaceShi. Thank you!

		 See: https://github.com/peaceshi/Avalonia-NativeAOT-SingleFile -->

	<!-- Windows x64 Native Libraries -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
		<PackageReference Include="2ndLAB.ANGLE.Static" Version="7151.0.0-10.0.26100.0-1.79e529b" />
		<PackageReference Include="2ndLAB.SkiaSharp.Static" Version="3.119.0-10.0.26100.0-1.1c7d845" />
	</ItemGroup>

	<!-- Windows x64 Native Linking -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
		<DirectPInvoke Include="libHarfBuzzSharp" />
		<DirectPInvoke Include="libSkiaSharp" />
		<DirectPInvoke Include="av_libglesv2" />
		<LinkerArg Include="d3d9.lib;dxguid.lib" />
		<LinkerArg Include="dxgi.lib" />
		<LinkerArg Include="Gdi32.lib;User32.lib" />
		<LinkerArg Include="synchronization.lib" />
		<LinkerArg Include="fontsub.lib;Ole32.lib;USP10.lib" />
		<LinkerArg Include="d3d12.lib;d3dcompiler.lib" />
		<LinkerArg Include="/LTCG" />
	</ItemGroup>

</Project>
