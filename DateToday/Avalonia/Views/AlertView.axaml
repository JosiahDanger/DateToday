<Window
	x:Class="DateToday.Avalonia.Views.AlertView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:conv="using:DateToday.Avalonia.Converters"
	xmlns:res="using:DateToday.Avalonia.Resources"
	xmlns:vm="using:DateToday.Avalonia.ViewModels"
	Title="DateToday - Alert"
	x:DataType="vm:AlertViewModel"
	Classes="AlertWindow">

	<Window.Styles>
		<StyleInclude Source="/Avalonia/Styles/AlertStyles.axaml" />
	</Window.Styles>

	<Border
		Background="{Binding Alert.Flavour, Mode=OneTime, Converter={x:Static conv:AlertFlavourConverters.AlertFlavourToBrushConverter}}"
		Classes="AlertOuterBorder">

		<StackPanel Orientation="Vertical">

			<TextBlock
				Classes="AlertCaption"
				Text="{Binding Alert.Flavour, Mode=OneTime, Converter={x:Static conv:AlertFlavourConverters.AlertFlavourToCaptionConverter}}" />

			<Border Classes="AlertInnerBorder">

				<ScrollViewer>

					<SelectableTextBlock
						Classes="AlertMessage"
						Text="{Binding Alert.Message, Mode=OneTime}" />

				</ScrollViewer>

			</Border>

			<Button
				Classes="CloseButton"
				Command="{Binding CloseAlertCommand, Mode=OneTime}"
				Content="{x:Static res:Strings.AlertView_Button_CloseAlert}" />

		</StackPanel>

	</Border>

</Window>
