<Window
	x:Class="DateToday.Avalonia.Views.WidgetView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:conv="using:DateToday.Avalonia.Converters"
	xmlns:res="using:DateToday.Avalonia.Resources"
	xmlns:vm="using:DateToday.Avalonia.ViewModels"
	Name="WidgetWindow"
	Title="{x:Static res:Strings.WidgetView_Window_Title}"
	x:DataType="vm:WidgetViewModel">

	<Window.Styles>
		<StyleInclude Source="/Avalonia/Styles/WidgetStyles.axaml" />
	</Window.Styles>

	<Window.ContextMenu>

		<ContextMenu Classes="WidgetContextMenu">

			<MenuItem
				Classes="WidgetContextMenuQuickSetting"
				Command="{Binding ToggleMouseDragCommand, Mode=OneTime}"
				Header="{Binding Position.IsMouseDragEnabled, Mode=OneWay, Converter={x:Static conv:WidgetViewConverters.IsMouseDragEnabledToggleLabelConverter}}">

				<MenuItem.Icon>
					<PathIcon Name="IsMouseDragEnabledToggleIcon" />
				</MenuItem.Icon>

			</MenuItem>

			<Separator />

			<MenuItem
				Classes="WidgetContextMenuItem"
				Command="{Binding OpenSettingsViewCommand, Mode=OneTime}"
				Header="{x:Static res:Strings.WidgetView_ContextMenu_MenuItem_OpenSettingsView}">

				<MenuItem.Icon>
					<PathIcon Name="OpenSettingsViewIcon" />
				</MenuItem.Icon>

			</MenuItem>

			<MenuItem
				Classes="WidgetContextMenuItem"
				Command="{Binding CloseApplicationCommand, Mode=OneTime}"
				Header="{x:Static res:Strings.WidgetView_ContextMenu_MenuItem_ExitApplication}">

				<MenuItem.Icon>
					<PathIcon Name="ExitApplicationIcon" />
				</MenuItem.Icon>

			</MenuItem>

		</ContextMenu>

	</Window.ContextMenu>

	<TextBlock
		Classes="WidgetTextBlock"
		FontFamily="{Binding Font.FontFamily}"
		FontSize="{Binding Font.FontSize}"
		FontWeight="{Binding Font.FontWeight}"
		Text="{Binding DateTimeText}" />

</Window>
