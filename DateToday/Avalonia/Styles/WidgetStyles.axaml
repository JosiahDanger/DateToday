<Styles
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Design.PreviewWith>

		<!--  Add Controls for Previewer Here  -->

	</Design.PreviewWith>

	<!--  Add Styles Here  -->

	<Style Selector="Window#WidgetWindow">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="CanMaximize" Value="False" />
		<Setter Property="CanMinimize" Value="False" />
		<Setter Property="CanResize" Value="False" />
		<Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="ShowInTaskbar" Value="False" />
		<Setter Property="SizeToContent" Value="WidthAndHeight" />
		<Setter Property="WindowDecorations" Value="None" />
		<Setter Property="WindowStartupLocation" Value="Manual" />
	</Style>

	<Style Selector="ContextMenu.WidgetContextMenu">
		<Setter Property="FontFamily" Value="fonts:FontCollection#Libre Franklin" />
	</Style>

	<Style Selector="MenuItem.WidgetContextMenuQuickSetting">
		<Setter Property="CornerRadius" Value="1" />
		<Setter Property="FontWeight" Value="Light" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Margin" Value="4 0 4 0" />
		<Setter Property="Padding" Value="10 6.5 -5 3.5" />
	</Style>

	<Style Selector="MenuItem.WidgetContextMenuItem">
		<Setter Property="CornerRadius" Value="1" />
		<Setter Property="FontWeight" Value="Regular" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Margin" Value="4 0 4 0" />
		<Setter Property="Padding" Value="10 5 -5 5" />
	</Style>

	<Style Selector="PathIcon#OpenSettingsViewIcon">
		<Setter Property="Data" Value="{StaticResource icon_settings}" />
	</Style>

	<Style Selector="PathIcon#ExitApplicationIcon">
		<Setter Property="Data" Value="{StaticResource icon_power}" />
	</Style>

	<Style Selector="TextBlock.WidgetTextBlock">
		<Setter Property="Padding" Value="10" />
	</Style>

</Styles>
