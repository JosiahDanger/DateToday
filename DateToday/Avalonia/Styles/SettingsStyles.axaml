<Styles
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Design.PreviewWith>

		<!--  Add Controls for Previewer Here  -->

		<Border
			Width="600"
			Height="400"
			Classes="SettingsOuterBorder">

			<Grid
				Classes="SettingsOuterGrid"
				ColumnDefinitions="Auto,*,20"
				RowDefinitions="25,*,*">

				<Border
					Grid.Row="0"
					Grid.RowSpan="3"
					Grid.Column="0"
					Classes="SettingsOuterNavigationGridBorder">

					<Grid
						Classes="SettingsOuterNavigationGrid"
						ColumnDefinitions="Auto"
						RowDefinitions="365, Auto">

						<TabStrip
							Grid.Row="0"
							Grid.Column="0"
							Classes="TabGroup">

							<UniformGrid
								Classes="SettingsInnerNavigationGrid"
								Columns="1"
								Rows="4">

								<TabStripItem
									Grid.Row="0"
									Classes="TabHeader"
									Content="Content" />

								<TabStripItem
									Grid.Row="1"
									Classes="TabHeader"
									Content="Position" />

								<TabStripItem
									Grid.Row="2"
									Classes="TabHeader"
									Content="Font" />

								<TabStripItem
									Grid.Row="3"
									Classes="TabHeader"
									Content="App" />

							</UniformGrid>

						</TabStrip>

						<TextBlock
							Grid.Row="1"
							Classes="AppVersion"
							Text="Ver. 2.0.0" />

					</Grid>

				</Border>

				<Border
					Grid.Row="0"
					Grid.RowSpan="3"
					Grid.Column="1"
					Classes="SettingsInnerBorder" />

				<Button
					Grid.Row="0"
					Grid.Column="2"
					Classes="CloseButton" />

				<Border
					Grid.Row="1"
					Grid.RowSpan="2"
					Grid.Column="2"
					Classes="SettingsWindowResizeHandle" />

			</Grid>

		</Border>

	</Design.PreviewWith>

	<!--  Add Styles Here  -->

	<Style Selector="Window.SettingsWindow">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="CanMaximize" Value="False" />
		<Setter Property="CanMinimize" Value="False" />
		<Setter Property="CanResize" Value="True" />
		<Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
		<Setter Property="Height" Value="400" />
		<Setter Property="MaxWidth" Value="800" />
		<Setter Property="MinWidth" Value="600" />
		<Setter Property="ShowInTaskbar" Value="True" />
		<Setter Property="SizeToContent" Value="Width" />
		<Setter Property="TransparencyLevelHint" Value="Mica" />
		<Setter Property="WindowDecorationProperties.ElementRole" Value="None" />
		<Setter Property="WindowDecorations" Value="None" />
		<Setter Property="WindowStartupLocation" Value="CenterOwner" />
	</Style>

	<Style Selector="Border.SettingsOuterBorder">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
		<Setter Property="WindowDecorationProperties.ElementRole" Value="TitleBar" />
	</Style>

	<Style Selector="Grid.SettingsOuterGrid">
		<Setter Property="Margin" Value="10" />
	</Style>

	<Style Selector="Button.CloseButton">
		<Setter Property="Background" Value="Red" />
		<Setter Property="Content" Value="🗙" />
		<Setter Property="FontFamily" Value="fonts:FontCollection#Drafting* Mono" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="Thin" />
		<Setter Property="Height" Value="20" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="UseLayoutRounding" Value="False" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="VerticalContentAlignment" Value="Top" />
		<Setter Property="Width" Value="20" />
		<Setter Property="WindowDecorationProperties.ElementRole" Value="CloseButton" />
	</Style>

	<Style Selector="Border.SettingsOuterNavigationGridBorder">
		<Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}" />
		<Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
	</Style>

	<Style Selector="Grid.SettingsOuterNavigationGrid">
		<!--  Placeholder  -->
	</Style>

	<Style Selector="UniformGrid.SettingsInnerNavigationGrid">
		<!--  Placeholder  -->
	</Style>

	<Style Selector="TabStrip.TabGroup">
		<Setter Property="Margin" Value="0 15 0 0" />
	</Style>

	<Style Selector="TabStripItem.TabHeader">
		<Setter Property="FontFamily" Value="fonts:FontCollection#Libre Franklin" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="Regular" />
		<Setter Property="Margin" Value="0 1" />
		<Setter Property="Padding" Value="7.5 0" />
		<Setter Property="WindowDecorationProperties.ElementRole" Value="User" />
	</Style>

	<Style Selector="TextBlock.AppVersion">
		<Setter Property="FontFamily" Value="fonts:FontCollection#Drafting* Mono" />
		<Setter Property="FontSize" Value="8" />
		<Setter Property="FontWeight" Value="ExtraLight" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="TextAlignment" Value="Center" />
	</Style>

	<Style Selector="Border.SettingsInnerBorder">
		<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorDark1}" />
		<Setter Property="BorderThickness" Value="2" />
		<Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
		<Setter Property="Margin" Value="15 2.5 10 2.5" />
	</Style>

	<Style Selector="Border.SettingsWindowResizeHandle">
		<Setter Property="Background" Value="{DynamicResource SystemChromeHighColor}" />
		<Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
		<Setter Property="Height" Value="75" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Width" Value="6" />
		<Setter Property="WindowDecorationProperties.ElementRole" Value="ResizeE" />
	</Style>

</Styles>
