<Project Sdk="Microsoft.NET.Sdk">

	<!-- See 'Directory.Build.props' for configuration related to trimming and NativeAOT. -->

	<!-- Build Target -->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<StartupObject>DateToday.Avalonia.Program</StartupObject>
		<Nullable>enable</Nullable>
		<NeutralLanguage>en-GB</NeutralLanguage>
	</PropertyGroup>

	<!-- Analyser Configuration -->
	<PropertyGroup>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<!-- Package Metadata -->
	<PropertyGroup>
		<Product>DateToday</Product>
		<Version>2.0.0</Version>
		<Description>A beautiful, lightweight desktop widget that displays the current date and/or time in a configurable format.</Description>
		<Authors>Josiah Danger Shaahin</Authors>
		<Copyright>© 2026 Josiah Danger Shaahin</Copyright>
		<RepositoryUrl>https://github.com/JosiahDanger/DateToday</RepositoryUrl>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<!-- Direct NuGet Dependencies -->
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.6" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Darp.CommunityToolkit.MvvmValidator" Version="0.1.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="PublishAotCompressed" Version="1.0.5" />
	</ItemGroup>

	<!-- Localised Resources -->
	<ItemGroup>
		<EmbeddedResource Update="Avalonia\Resources\Strings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>

		<Compile Update="Avalonia\Resources\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<!-- Avalonia Resources -->
	<ItemGroup>
		<AvaloniaResource Include="Avalonia\Fonts\*.otf" />
		<AvaloniaResource Include="Avalonia\Fonts\*.ttf" />
		<AvaloniaResource Include="Avalonia\Geometries\Icons.axaml" />
	</ItemGroup>

	<!-- Windows Platform -->
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
		<ApplicationIcon>DateToday Icon.ico</ApplicationIcon>
		<NoWin32Manifest>true</NoWin32Manifest>
	</PropertyGroup>

</Project>
